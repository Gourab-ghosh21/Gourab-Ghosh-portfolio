# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Nodemailer / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Receiver Email for Contact Inquiries
CONTACT_RECEIVER_EMAIL=ggourab217@gmail.com

# Allowed Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:5173
